@model VendorModel
@{
    ViewBag.Title = "Vendor Details";
}
<h2 class="text-center">My Vendor Details</h2>
<div class="container mt-4">
    @if(ViewBag.Message != null)
    {
        <div class="alert alert-success">@ViewBag.Message</div>
    }
    @using (Html.BeginForm("Manage", "VendorAccount", FormMethod.Post))
    {
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(m => m.Name)
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Category)
            @Html.TextBoxFor(m => m.Category, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.Description)
            @Html.TextAreaFor(m => m.Description, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.ContactInfo)
            @Html.TextBoxFor(m => m.ContactInfo, new { @class = "form-control" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.PriceEstimate)
            @Html.TextBoxFor(m => m.PriceEstimate, new { @class = "form-control", type = "number", step = "0.01" })
        </div>
        <button type="submit" class="btn btn-primary w-100 mt-3">Save</button>
    }
</div>
